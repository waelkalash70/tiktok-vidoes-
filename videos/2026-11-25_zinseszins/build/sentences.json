  {
   "id": "s1",
   "start": 0.15,
   "end": 2.739,
   "text": "Anna spart nur zehn Jahre. Ben dreißig Jahre."
  },
  {
   "id": "s2",
   "start": 3.039,
   "end": 5.024,
   "text": "Trotzdem ist Anna am Ende reicher."
  },
  {
   "id": "s3",
   "start": 5.374,
   "end": 6.199,
   "text": "Wie geht das?"
  },
  {
   "id": "s4",
   "start": 6.649,
   "end": 10.05,
   "text": "Anna legt ab fünfundzwanzig jeden Monat dreihundert Euro an."
  },
  {
   "id": "s5",
   "start": 10.3,
   "end": 14.166,
   "text": "Mit fünfunddreißig hört sie auf. Eingezahlt: sechsunddreißigtausend Euro."
  },
  {
   "id": "s6",
   "start": 14.616,
   "end": 18.993,
   "text": "Ben fängt erst mit fünfunddreißig an und zahlt dreißig Jahre lang dreihundert Euro."
  },
  {
   "id": "s7",
   "start": 19.243,
   "end": 21.287,
   "text": "Eingezahlt: hundertachttausend Euro."
  },
  {
   "id": "s8",
   "start": 21.737,
   "end": 23.885,
   "text": "Beide bekommen sieben Prozent Rendite im Jahr."
  },
  {
   "id": "s9",
   "start": 24.285,
   "end": 25.271,
   "text": "Und jetzt kommt's:"
  },
  {
   "id": "s10",
   "start": 26.171,
   "end": 29.724,
   "text": "Ben hat mit fünfundsechzig: dreihundertsechsundsechzigtausend Euro."
  },
  {
   "id": "s11",
   "start": 30.174,
   "end": 32.914,
   "text": "Anna: vierhunderteinundzwanzigtausend Euro!"
  },
  {
   "id": "s12",
   "start": 33.414,
   "end": 34.9,
   "text": "Mit einem Drittel des Geldes."
  },
  {
   "id": "s13",
   "start": 35.4,
   "end": 37.467,
   "text": "Nicht die Summe zählt. Sondern die Zeit."
  },
  {
   "id": "s14",
   "start": 38.017,
   "end": 39.909,
   "text": "Teil zwei: Wie du heute startest."
  }
